# --- LLM providers ------------------------------------------------------
# Paid model (OpenAI) — powers the specialist agents that write the plans.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Free model (Groq) — powers routing and the QA gate (high volume, cheap).
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Per-role provider override: "openai" or "groq".
ROUTER_PROVIDER=groq
SPECIALIST_PROVIDER=openai
QA_PROVIDER=groq

# --- Memory (optional) ---------------------------------------------------
# Leave unset to run in ledger-fallback mode (fully functional, nothing persisted).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=productivity_coach

# --- API -----------------------------------------------------------------
COACH_HOST=0.0.0.0
COACH_PORT=8000
